{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "papyrs-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_URL": "https://papyrs-connector.sanja-ples.workers.dev",
    "PAPYRS_BASE_URL": "https://ch-aviation.papyrs.com",
    "PAPYRS_SUBSITE": "home",
    "PAPYRS_SUBSITES": "home=Intranet Home,accounting=Accounting,belgrade-office=Belgrade office,data=Data team docs and manuals,data-drafts=Data Drafts,data-sales=Data Sales instructions,development=Development,executive-corner=Executive Corner,human-resources=Human Resources,hr-and-finance=HR and Finance,learning-center=Learning Center: aviation and Excel and data processing,management-2=Management,marketing=Marketing,news=News,pmo=PMO,penang-office=Penang office,publishing=Publishing,recruitment=Recruitment,remote-workers=Remote Workers,sales=Sales docs and manuals,sales-marketing-management=Sales & Marketing Management,sales-team-2030=Sales Team 2030,zagreb-office-2=Zagreb Office",
    "DRAFT_FOLDER": "Claude drafts",
    "REVIEWER_IDS": "",
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com"
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV" },
    { "binding": "REVIEW_KV" }
  ],
  "observability": { "enabled": true }
}
