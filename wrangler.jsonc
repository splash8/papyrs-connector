{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "papyrs-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_URL": "https://papyrs-connector.sanja-ples.workers.dev",
    "PAPYRS_BASE_URL": "https://ch-aviation.papyrs.com",
    "PAPYRS_SUBSITE": "home",
    "PAPYRS_SUBSITES": "",
    "DRAFT_FOLDER": "Claude drafts",
    "REVIEWER_IDS": "",
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com"
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV" },
    { "binding": "REVIEW_KV" }
  ],
  "observability": { "enabled": true }
}
